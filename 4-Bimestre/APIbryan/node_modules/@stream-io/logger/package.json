{
  "name": "@stream-io/logger",
  "version": "2.1.0",
  "description": "Logging library for Stream.io JS-based SDKs and applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts"
  ],
  "keywords": [
    "logging"
  ],
  "author": {
    "name": "GetStream.io, Inc.",
    "url": "https://getstream.io/team/"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/node": "^22.16.4",
    "typescript": "^5.9.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check:package": "publint && attw --pack . --ignore-rules false-cjs",
    "test": "node --test --experimental-transform-types src/index.test.ts"
  }
}