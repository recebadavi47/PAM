{
  "name": "@stream-io/i18n",
  "version": "1.1.0",
  "description": "Translation runtime shared across Stream.io JS SDKs: i18next wrapper, date/time formatters and a build-time catalog generator",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./codegen": {
      "import": {
        "types": "./dist/codegen/index.d.ts",
        "default": "./dist/codegen/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "codegen",
    "!src/__tests__",
    "!codegen/__tests__"
  ],
  "keywords": [
    "i18n",
    "i18next",
    "translation",
    "localization",
    "stream"
  ],
  "author": {
    "name": "GetStream.io, Inc.",
    "url": "https://getstream.io/team/"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@stream-io/state-store": "^1.2.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "use-sync-external-store": "^1.7.0"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.16.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "jsdom": "^25.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.5"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "codegen": [
        "./dist/codegen/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.codegen.config.mts && tsc -p tsconfig.build.json && tsc -p tsconfig.codegen.json",
    "check:package": "publint && attw --pack . --ignore-rules false-cjs --exclude-entrypoints ./codegen",
    "types:consumer": "tsc -p tsconfig.consumer.json",
    "test": "pnpm run build && pnpm run types:consumer && TZ=UTC node --test --experimental-transform-types 'src/**/*.test.ts' 'codegen/**/*.test.ts'"
  }
}