{
  "name": "@stream-io/state-store",
  "version": "1.2.0",
  "description": "State management library for Stream.io JS-based SDKs and applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react-bindings": {
      "types": "./dist/bindings/react/index.d.ts",
      "import": "./dist/bindings/react/index.mjs",
      "require": "./dist/bindings/react/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "react-bindings": [
        "./dist/bindings/react/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "use-sync-external-store": "^1.5.0",
    "react": "^17 || ^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "use-sync-external-store": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "state",
    "store",
    "data",
    "management"
  ],
  "author": {
    "name": "GetStream.io, Inc.",
    "url": "https://getstream.io/team/"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/react": "^19",
    "@types/use-sync-external-store": "^1.5.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check:package": "publint && attw --pack . --ignore-rules false-cjs"
  }
}